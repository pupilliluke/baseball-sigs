rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signature projects belong either to a signed-in Google account (userId ==
    // the Firebase uid) or to a signed-out browser (userId == "user_<random>").
    // Account-owned documents can only be written by that account; guest
    // documents stay writable so guests can edit them and so a first sign-in
    // can claim them.
    match /signature-projects/{projectId} {

      function isGuestId(id) {
        return id is string && id.matches('^user_.*');
      }
      function ownsExisting() {
        return isGuestId(resource.data.userId)
          || (request.auth != null && resource.data.userId == request.auth.uid);
      }
      function ownsIncoming() {
        return isGuestId(request.resource.data.userId)
          || (request.auth != null && request.resource.data.userId == request.auth.uid);
      }

      allow read: if true;
      allow create: if isValidProject() && ownsIncoming();
      // Updating requires owning the document both before and after, so no one
      // can reassign another account's project to themselves.
      allow update: if isValidProject() && ownsExisting() && ownsIncoming();
      allow delete: if ownsExisting();

      function isValidProject() {
        let d = request.resource.data;
        return d.keys().hasOnly(['userId', 'projectName', 'signatureNames', 'signatures', 'sport', 'category', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['userId', 'projectName', 'signatureNames'])
          && d.userId is string
          && d.userId.size() > 0
          && d.userId.size() <= 128
          && d.projectName is string
          && d.projectName.size() > 0
          && d.projectName.size() <= 100
          && d.signatureNames is list
          && d.signatureNames.size() <= 300
          && (!('signatures' in d) || (d.signatures is list && d.signatures.size() <= 300))
          && (!('sport' in d) || d.sport in ['baseball', 'basketball', 'football'])
          && (!('category' in d) || (d.category is string && d.category.size() > 0 && d.category.size() <= 40));
      }
    }

    // A person's own category names, so the set follows the account across
    // devices instead of living in one browser. Keyed by owner id: a Firebase
    // uid when signed in, or a "user_<random>" guest id.
    match /user-categories/{ownerId} {

      function isGuestOwner() {
        return ownerId is string && ownerId.matches('^user_.*');
      }
      function isOwner() {
        return isGuestOwner() || (request.auth != null && request.auth.uid == ownerId);
      }
      function isValidCategories() {
        let d = request.resource.data;
        return d.keys().hasOnly(['categories', 'updatedAt'])
          && d.categories is list
          && d.categories.size() <= 50;
      }

      allow read: if true;
      allow create, update: if isOwner() && isValidCategories();
      allow delete: if isOwner();
    }
  }
}
