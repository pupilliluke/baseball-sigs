rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signature projects are lightweight public lists (no auth yet), so the
    // rules focus on constraining document shape and size rather than identity.
    match /signature-projects/{projectId} {
      allow read: if true;
      allow create, update: if isValidProject();
      allow delete: if true;

      function isValidProject() {
        let d = request.resource.data;
        return d.keys().hasOnly(['userId', 'projectName', 'signatureNames', 'signatures', 'sport', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['userId', 'projectName', 'signatureNames'])
          && d.userId is string
          && d.userId.size() > 0
          && d.userId.size() <= 64
          && d.projectName is string
          && d.projectName.size() > 0
          && d.projectName.size() <= 100
          && d.signatureNames is list
          && d.signatureNames.size() <= 300
          && (!('signatures' in d) || (d.signatures is list && d.signatures.size() <= 300))
          && (!('sport' in d) || d.sport in ['baseball', 'basketball', 'football']);
      }
    }
  }
}
